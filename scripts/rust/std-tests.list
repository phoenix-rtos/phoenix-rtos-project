# std's unit tests
# skipped:
#   fs:: - fs::remove_dir_all leaves files behind (ENOTEMPTY), so every test's tmpdir cleanup fails
#   net:: - no network on the target
#   process:: - no process spawning
#   test_try_reserve - libphoenix malloc truncates sizes of 4 GiB and more (malloc_dl.c)
std-unittests --skip fs:: --skip net:: --skip process:: --skip test_try_reserve
std-unittests os::unix::fs --skip test_mkfifo
# std-unittests os::unix::net # kernel AF_UNIX connect() blocks until the listener accepts, so tests hang

# core's and alloc's
coretests --skip flt2dec
alloctests-unittests --skip try_reserve
