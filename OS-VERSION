# Phoenix-RTOS version of this source tree (SemVer-like): MAJOR.MINOR.PATCH[-TAG][+BUILD]
# Read by phoenix-rtos-build/makes/version.mk, valid for both make and bash:
# NAME=value without spaces, values only in [0-9A-Za-z.], MAJOR/MINOR/PATCH 0-999.
VER_MAJOR=3
VER_MINOR=4
VER_PATCH=0
# Tag (SemVer: Pre-release). Empty on a release. Otherwise: "dev" (development), "rc.N"
# (release candidate N), "rc.N.dev" (development after "rc.N") - all towards the version
# specified above.
VER_TAG=dev
# Build metadata
VER_BUILD=
